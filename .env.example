# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=sistema_rh
POSTGRES_USER=sistema_rh
POSTGRES_PASSWORD=sistema_rh
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=sistema_rh
RABBITMQ_PASSWORD=sistema_rh
RABBITMQ_VHOST=/

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=sistema_rh
MINIO_SECRET_KEY=sistema_rh_secret
MINIO_USE_SSL=False
MINIO_BUCKET_CURRICULOS=curriculos-anexos
MINIO_BUCKET_ADMISSAO=admissao-documentos

# CORS (frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
